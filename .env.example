# =========================
# Site
# =========================
NEXT_PUBLIC_SITE_URL=https://ip6original.com
NEXT_PUBLIC_SITE_NAME="IP6 Original"
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,fr,de,hi
NEXT_PUBLIC_NSF_CERTIFIED=false

# Comma-separated ISO-3166-1 alpha-2 codes permitted for supplement + skincare shipping
PERMITTED_SUPPLEMENT_COUNTRIES=US,CA,GB,AU,NZ,IE,DE,FR,NL,BE,AT,CH,DK,SE,NO,FI,ES,PT,IT,PL,CZ,IL,AE,JP,KR,HK,SG,MY

# =========================
# AWS
# =========================
# Region of the data stacks. Amplify sets AWS_REGION to its own region and rejects variables starting with AWS, so the app reads APP_AWS_REGION first.
APP_AWS_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_PREFIX=ip6_prod_
S3_ASSETS_BUCKET=ip6original-assets
CLOUDFRONT_DOMAIN=
NEXT_PUBLIC_CDN_URL=
# Any address on the SES-verified domain; the app sends from orders@, privacy@ and hello@ on that domain.
SES_FROM_EMAIL=orders@ip6original.com
# CDK output SesConfigurationSet (ip6-prod or ip6-staging): TLS, suppression list, bounce and complaint alerts.
SES_CONFIGURATION_SET=ip6-prod

# =========================
# Cognito: two separate user pools (see docs/ADMIN.md)
# =========================
# Customer accounts (self sign-up). CDK outputs UserPoolId / UserPoolClientId.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Staff accounts for /admin (owner-created only, MFA required).
# CDK outputs StaffUserPoolId / StaffUserPoolClientId.
STAFF_COGNITO_USER_POOL_ID=
STAFF_COGNITO_CLIENT_ID=
STAFF_COGNITO_CLIENT_SECRET=

# Admin portal: 32 random bytes, base64 (openssl rand -base64 32). Required in production.
# Encrypts customer links inside the admin portal so emails never appear in URLs.
ADMIN_LINK_KEY=
# Which Secrets Manager set to read: prod or staging.
APP_ENV=prod

# =========================
# Stripe — TEST MODE
# Switch to live keys at launch (see lib/stripe/server.ts)
# =========================
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_TAX_ENABLED=true

# =========================
# Sanity CMS
# =========================
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-09-20
SANITY_API_TOKEN=

# =========================
# Algolia
# =========================
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_PRODUCTS_INDEX=products
ALGOLIA_ADMIN_KEY=

# =========================
# Analytics (loaded only after cookie consent)
# =========================
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# =========================
# Shipping (optional — for live carrier rates)
# =========================
SHIPPO_API_KEY=

# =========================
# Security
# =========================
RATE_LIMIT_SECRET=change-me-in-production
