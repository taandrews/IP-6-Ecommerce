        <a href="#" aria-label="YouTube" title="YouTube — coming soon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
        <a href="#" aria-label="LinkedIn" title="LinkedIn — coming soon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg></a>
      </nav>
      <span>&copy; IP6 Original 2026</span>
      </div>
    </footer>
    <style>
      .ip6-mini-footer { background: #fff; border-top: 1px solid var(--line, #e6eaf0); padding: 14px 40px; }
      .ftr-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
      .ip6-footer-logo { display: inline-flex; flex: 0 0 auto; }
      .ip6-footer-logo img { height: 60px; width: auto; display: block; }
      .ip6-social { display: flex; gap: 20px; }
      .ip6-social a { color: #9aa3b2; display: inline-flex; transition: color .15s ease-out, transform .15s ease-out; }
      .ip6-social a:hover { color: var(--gold-deep, #a8842f); transform: translateY(-2px); }
      .ip6-social svg { width: 19px; height: 19px; display: block; }
      .ip6-mini-footer span { font-family: var(--sans, sans-serif); font-size: 12.5px; letter-spacing: .02em; color: var(--muted, #5b6470); }
      @media (max-width: 749px) { .ip6-mini-footer { padding: 14px 16px; } .ip6-footer-logo img { height: 44px; } }
      @media (max-width: 640px) { .ftr-inner { justify-content: center; text-align: center; } }
    </style>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% render 'ip6-quiz' %}
  </body>
</html>
