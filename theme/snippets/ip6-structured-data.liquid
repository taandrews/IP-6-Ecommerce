{%- comment -%}
  IP6 structured data (JSON-LD) for SEO + AEO. Rendered in <head>.
  Organization + WebSite site-wide; Product on product pages;
  BreadcrumbList on product & collection pages.
{%- endcomment -%}
{%- assign home = request.origin | append: routes.root_url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ home | json }},
  "logo": {{ 'ip6-logo.png' | asset_url | prepend: 'https:' | json }},
  "description": {{ shop.description | default: 'Research-grade IP6 (inositol hexaphosphate) and Inositol, formulated by the scientist who pioneered the research.' | json }},
  "founder": {
    "@type": "Person",
    "name": "Prof. AbulKalam M. Shamsuddin, MD, PhD"
  }
  {%- if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_twitter_link != blank -%}
  ,"sameAs": [
    {%- assign sep = '' -%}
    {%- if settings.social_instagram_link != blank -%}{{ sep }}{{ settings.social_instagram_link | json }}{%- assign sep = ',' -%}{%- endif -%}
    {%- if settings.social_facebook_link != blank -%}{{ sep }}{{ settings.social_facebook_link | json }}{%- assign sep = ',' -%}{%- endif -%}
    {%- if settings.social_twitter_link != blank -%}{{ sep }}{{ settings.social_twitter_link | json }}{%- endif -%}
  ]
  {%- endif -%}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ home | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ home }}search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- if request.page_type == 'product' and product -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
  {%- assign price_valid = 'now' | date: '%Y' | plus: 1 | append: '-12-31' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  {%- if product.featured_image -%}
  "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
  {%- endif -%}
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "brand": { "@type": "Brand", "name": "IP6 Original" },
  {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": {{ request.origin | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ variant.price | money_without_currency | replace: ',', '' }}",
    "priceValidUntil": "{{ price_valid }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": {{ cart.currency.iso_code | json }} },
      "shippingDestination": [
        { "@type": "DefinedRegion", "addressCountry": "US" },
        { "@type": "DefinedRegion", "addressCountry": "CA" }
      ]
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": ["US", "CA"],
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ home | json }} },
    { "@type": "ListItem", "position": 2, "name": "Shop", "item": {{ request.origin | append: '/collections/shop' | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
  ]
}
</script>
{%- endif -%}
{%- if request.page_type == 'collection' and collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ home | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
  ]
}
</script>
{%- endif -%}
