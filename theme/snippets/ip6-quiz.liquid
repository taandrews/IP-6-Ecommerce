{%- comment -%}
  Pre-order pop-up, the same questionnaire as ip6original.com: the offer, an
  email step, five quick questions, then the match with the pre-order price.
  Opens once the visitor has scrolled past the first screen, after 45 seconds,
  or on exit intent; never again for 30 days. ?quiz=1 or #quiz forces it open.
  The email is saved as a Shopify customer (newsletter form), tagged prebook_popup.
{%- endcomment -%}
{%- liquid
  assign cdn = settings.ip6_cdn
  assign qp = all_products['ip-6-original']
  assign pct = settings.ip6_preorder_pct | default: 15
  assign keep = 100 | minus: pct
  assign list_cents = qp.price | default: 4999
  assign offer_cents = list_cents | times: keep | divided_by: 100.0 | round
-%}
<link rel="stylesheet" href="{{ 'ip6-popup.css' | asset_url }}">
<style>
  #ip6quiz { display: none; }
  #ip6quiz.open { display: block; }
  #ip6quiz .step { display: none; }
  #ip6quiz .step.active { display: block; }
  #ip6quiz .inner.productOffer { text-align: left; }
  #ip6quiz .opt, #ip6quiz .input, #ip6quiz .btn, #ip6quiz .cta, #ip6quiz .close, #ip6quiz .unit { border-radius: 0 !important; }
  #ip6quiz .h2, #ip6quiz .offer { font-family: "Source Serif 4", Georgia, serif !important; font-weight: 500 !important; }
  #ip6quiz .srOnly { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
<div id="ip6quiz" role="dialog" aria-modal="true" aria-label="Pre-order IP6 Original and receive {{ pct }}% off" class="root">
  <div class="panel">
    <div class="media" aria-hidden="true" style="background-image: url('{{ cdn }}/popup/ip6-quiz.jpg')">
      <div class="mtag">
        <div class="mtagE">Science Driven · Purity First</div>
        <div class="mtagH">Strengthen your cellular health</div>
      </div>
    </div>
    <div class="side">
      <div class="bar"><i data-bar style="width:0%"></i></div>
      <div class="top">
        <span class="brand">IP6 Original</span>
        <button type="button" class="close" data-close>No thanks &times;</button>
      </div>
      <div class="body">
        <div class="inner">
          <div class="step active" data-step="intent">
            <span class="eyebrow">From the lab of Professor AbulKalam M. Shamsuddin, MD, PhD</span>
            <div class="launch">
              <div class="kicker">Pre-order open · {{ settings.ip6_preorder_ship | default: 'Starts shipping November 2026' }}</div>
              <div class="offer">Pre-Order Now &amp; Receive <b>{{ pct }}% Off</b></div>
              <div class="count" aria-label="Time until launch" data-count hidden>
                <div class="unit"><div class="num" data-d>0</div><div class="lbl">Days</div></div>
                <div class="unit"><div class="num" data-h>00</div><div class="lbl">Hours</div></div>
                <div class="unit"><div class="num" data-m>00</div><div class="lbl">Min</div></div>
                <div class="unit"><div class="num" data-s>00</div><div class="lbl">Sec</div></div>
              </div>
            </div>
            <p class="sub">What brings you to IP6 Original?</p>
            <div class="opts">
              <button type="button" class="opt" data-pick="intent" data-v="everyday">Everyday cellular health &amp; longevity <span aria-hidden="true">&rarr;</span></button>
              <button type="button" class="opt" data-pick="intent" data-v="immune">Immune &amp; antioxidant support <span aria-hidden="true">&rarr;</span></button>
              <button type="button" class="opt" data-pick="intent" data-v="research">I follow the research <span aria-hidden="true">&rarr;</span></button>
              <button type="button" class="opt" data-pick="intent" data-v="family">For a family member <span aria-hidden="true">&rarr;</span></button>
            </div>
          </div>

          <div class="step" data-step="email">
            <h2 class="h2">Where should we send your {{ pct }}% off?</h2>
            <p class="sub">Your pre-order discount is reserved. Answer a few quick questions and it's yours.</p>
            <form class="form" data-email-form novalidate>
              <label for="pb-email" class="srOnly">Email address</label>
              <input id="pb-email" type="email" class="input" placeholder="Email address" required autocomplete="email">
              <label class="consent"><input type="checkbox" data-consent required> Email me my pre-order offer and occasional research-backed updates.</label>
              <div class="err" data-err hidden>Please enter your email and check the box to continue.</div>
              <button type="submit" class="btn">Continue</button>
              <p class="micro">Unsubscribe anytime. No spam.</p>
            </form>
          </div>

          {%- assign q_eyebrows = "A quick question|What matters most|Your goal|Your routine|Almost done" | split: "|" -%}
          {%- assign q_titles = "Have you taken IP6 before?|What matters most to you in a supplement?|What's your main goal right now?|How would you describe your supplement routine?|Your age range" | split: "|" -%}
          {%- assign q_keys = "experience|values|goal|routine|age" | split: "|" -%}
          {%- assign q_opts = "regular=I take it regularly;tried=I've tried it;new=No, I'm new to IP6|purity=Purity & third-party testing;research=Research-backed ingredients;founder=Formulated by the scientist behind the research;clean=Clean formulation, no fillers|cellular=General cellular health & longevity;immune=Immune & antioxidant support;aging=Healthy aging;protocol=Following a protocol / my doctor's guidance|daily=Daily, I'm consistent;onoff=On and off;starting=Just getting started|18-34=18 to 34;35-49=35 to 49;50-64=50 to 64;65+=65+" | split: "|" -%}
          {%- for title in q_titles -%}
            {%- assign idx = forloop.index0 -%}
            <div class="step" data-step="q{{ forloop.index | plus: 1 }}">
              <p class="eyebrow">{{ q_eyebrows[idx] }}</p>
              <h2 class="h2">{{ title }}</h2>
              <div class="opts">
                {%- assign opts = q_opts[idx] | split: ";" -%}
                {%- for o in opts -%}
                  {%- assign kv = o | split: "=" -%}
                  <button type="button" class="opt" data-pick="{{ q_keys[idx] }}" data-v="{{ kv[0] }}">{{ kv[1] }} <span aria-hidden="true">&rarr;</span></button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <div class="step" data-step="reveal">
            <img class="resultImage" src="{{ cdn }}/products/supplement-240.png" alt="IP6 Original Supplement, 240 capsules" width="180" height="220" loading="lazy">
            <span class="eyebrow">Your match</span>
            <h2 class="h2">IP6 Original is your match.</h2>
            <p class="sub" data-result></p>
            <p class="price">Pre-order price with {{ pct }}% off: <b>{{ offer_cents | money }}</b> <s>{{ list_cents | money }}</s></p>
            <p class="micro">Your pre-order offer will be emailed to <span data-email-echo></span>. {{ settings.ip6_preorder_ship | default: 'Starts shipping November 2026' }}.</p>
            <a class="cta" href="{{ routes.collections_url }}/shop#people" data-cta>See IP6 Original &rarr;</a>
            <p class="nudge" data-nudge>Subscribe &amp; save to keep the discount going.</p>
            <div class="reassure"><span>cGMP Certified</span><span>Third-Party Tested</span><span>Made in USA</span></div>
          </div>
        </div>
      </div>
      <div class="disc">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</div>
    </div>
  </div>
</div>
<script>
  (function () {
    var KEY = 'ip6quiz_seen_v1', LAUNCH = Date.parse('{{ settings.ip6_launch_iso | default: "2026-11-01T04:00:00Z" }}');
    var root = document.getElementById('ip6quiz'); if (!root) return;
    var ORDER = ['intent', 'email', 'q2', 'q3', 'q4', 'q5', 'q6', 'reveal'];
    var RESULT = {
      everyday: 'A high-purity IP6 and Inositol formula for daily cellular health support, made to the standard the research describes.',
      immune: 'IP6 is a naturally occurring antioxidant. IP6 Original delivers it at the highest purity, third-party tested.',
      research: 'The original formula, built by the physician-scientist who pioneered the research, formulated to his specification.',
      family: 'A clean, third-party-tested formula you can feel good about sharing.'
    };
    var answers = {}, email = '', lastFocused = null, opened = false;
    function seen() { try { if (localStorage.getItem(KEY)) return true; } catch (e) {} return document.cookie.indexOf(KEY + '=1') >= 0; }
    function mark() { try { localStorage.setItem(KEY, '1'); } catch (e) {} document.cookie = KEY + '=1;path=/;max-age=2592000'; }
    function show() {
      if (opened || seen()) return; opened = true; lastFocused = document.activeElement;
      root.classList.add('open'); document.body.style.overflow = 'hidden';
      var c = root.querySelector('[data-close]'); if (c) c.focus();
    }
    function close() { root.classList.remove('open'); document.body.style.overflow = ''; mark(); if (lastFocused && lastFocused.focus) lastFocused.focus(); }
    function go(step) {
      root.querySelectorAll('[data-step]').forEach(function (el) { el.classList.toggle('active', el.getAttribute('data-step') === step); });
      var i = ORDER.indexOf(step), qs = ORDER.indexOf('email'), qe = ORDER.indexOf('reveal');
      var pct = i < qs ? 0 : Math.min(100, Math.round(((i - qs) / (qe - qs)) * 100));
      root.querySelector('[data-bar]').style.width = pct + '%';
      if (step === 'reveal') {
        var r = RESULT[answers.intent] || RESULT.everyday;
        if (answers.experience === 'new') r += ' New to IP6? Take 4 capsules once or twice daily with water.';
        root.querySelector('[data-result]').textContent = r;
        root.querySelector('[data-email-echo]').textContent = email;
        root.querySelector('[data-nudge]').innerHTML = (answers.routine === 'daily' || answers.experience === 'regular') ? 'You take it daily, <b>Subscribe &amp; Save</b> makes it a standing 15% off monthly, cancel anytime.' : 'Subscribe &amp; save to keep the discount going.';
      }
      var side = root.querySelector('.side'); if (side) side.scrollTop = 0;
    }
    root.querySelectorAll('[data-pick]').forEach(function (b) {
      b.addEventListener('click', function () {
        var q = b.getAttribute('data-pick'); answers[q] = b.getAttribute('data-v');
        var cur = b.closest('[data-step]').getAttribute('data-step');
        go(cur === 'intent' ? 'email' : ORDER[ORDER.indexOf(cur) + 1] || 'reveal');
      });
    });
    root.querySelector('[data-email-form]').addEventListener('submit', function (e) {
      e.preventDefault();
      var input = root.querySelector('#pb-email'), consent = root.querySelector('[data-consent]'), err = root.querySelector('[data-err]');
      var v = input.value.trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v) || !consent.checked) { err.hidden = false; return; }
      err.hidden = true; email = v;
      var fd = new FormData(); fd.append('form_type', 'customer'); fd.append('utf8', '✓'); fd.append('contact[email]', v); fd.append('contact[tags]', 'newsletter,prebook_popup,intent:' + (answers.intent || ''));
      fetch('/contact', { method: 'POST', body: fd, credentials: 'same-origin' }).catch(function () {});
      go('q2');
    });
    root.querySelector('[data-close]').addEventListener('click', close);
    root.querySelector('[data-cta]').addEventListener('click', mark);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && root.classList.contains('open')) close(); });
    // Countdown to launch
    var count = root.querySelector('[data-count]');
    function tick() {
      var left = LAUNCH - Date.now(); if (!(left > 0)) { count.hidden = true; return; }
      count.hidden = false; var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      count.querySelector('[data-d]').textContent = Math.floor(left / 86400000);
      count.querySelector('[data-h]').textContent = pad(Math.floor(left / 3600000) % 24);
      count.querySelector('[data-m]').textContent = pad(Math.floor(left / 60000) % 60);
      count.querySelector('[data-s]').textContent = pad(Math.floor(left / 1000) % 60);
    }
    tick(); setInterval(tick, 1000);
    // Triggers
    var params = new URLSearchParams(location.search);
    if (params.get('quiz') === '1' || location.hash === '#quiz') {
      try { localStorage.removeItem(KEY); } catch (e) {} document.cookie = KEY + '=;path=/;max-age=0';
      setTimeout(show, 300); return;
    }
    if (seen()) return;
    var loadedAt = Date.now();
    setTimeout(show, 45000);
    window.addEventListener('scroll', function () { if (Date.now() - loadedAt > 1500 && window.scrollY > window.innerHeight * 0.9) show(); }, { passive: true });
    document.addEventListener('mouseout', function (e) { if (e.clientY <= 0) show(); });
  })();
</script>
