{%- comment -%}
  IP6 Original store: fonts, the design system stylesheet, and the header,
  announcement and cart drawer styled to it.
{%- endcomment -%}
<script>
  try {
    if (!window.sessionStorage || !sessionStorage.getItem('ip6_sw_flushed')) {
      if (window.sessionStorage) sessionStorage.setItem('ip6_sw_flushed', '1');
      if ('serviceWorker' in navigator) navigator.serviceWorker.getRegistrations().then(function (rs) { rs.forEach(function (r) { r.unregister(); }); }).catch(function () {});
      if (window.caches && caches.keys) caches.keys().then(function (ks) { ks.forEach(function (k) { caches.delete(k); }); }).catch(function () {});
    }
  } catch (e) {}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="{{ settings.ip6_cdn }}" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ 'ip6-store.css' | asset_url }}">
{% render 'ip6-geo' %}
<style>
  /* Legacy names some kept pieces still read */
  :root { --ink: #001840; --ink-2: #001840; --paper: #fff; --bg: #fff; --surface: #F7F8FA; --line: #E3E7EC; --gold-deep: #7E5A14; --teal: #7E5A14; --cyan: #001840;
    --ip6-navy: #001840; --ip6-navy-hover: #0C2C5E; --ip6-gold: #B08830; --ip6-gold-700: #7E5A14; --ip6-gold-600: #87641C; --ip6-gold-300: #E8C870; --ip6-gold-100: #F4DFA0; --ip6-cloud-300: #DBE1E9; --ip6-line: #E3E7EC;
    --font-body--family: "Inter", sans-serif !important; --font-subheading--family: "Inter", sans-serif !important;
    --font-heading--family: "Source Serif 4", Georgia, serif !important; --font-accent--family: "Source Serif 4", Georgia, serif !important; }
  body { background: #fff; color: #001840; font-family: "Inter", sans-serif; }

  /* Header: white, hairline, centered menu, square navy button */
  #header-group .header { background: #fff; border-bottom: 1px solid #E3E7EC; }
  #header-group .header-logo__image { height: {{ settings.logo_height }}px !important; width: auto !important; max-height: none !important; }
  @media (max-width: 749px) { #header-group .header-logo__image { height: {{ settings.logo_height_mobile }}px !important; } }
  #header-group .menu__link { font-family: "Inter", sans-serif; font-size: 14px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #001840; }
  #header-group .menu__link:hover { color: #7E5A14; }
  #header-group .header-actions, #header-group .header-actions a, #header-group .header-actions button { color: #001840; }
  .ip6-header-cta { display: inline-flex; align-items: center; height: 40px; margin: 0 6px; padding: 0 16px; background: #001840; color: #fff !important; font-family: "Inter", sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; text-decoration: none; }
  .ip6-header-cta:hover { background: #0C2C5E; }
  @media (max-width: 749px) { .ip6-header-cta { display: none; } #header-group .announcement-bar, #header-group .announcement-bar * { font-size: 10px !important; letter-spacing: .06em !important; } }

  /* Ship to country: globe and code over a hidden native select */
  .ip6-shipto { position: relative; display: inline-flex; align-items: center; gap: 4px; height: 40px; padding: 0 8px; color: #001840; font-family: "Inter", sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .06em; cursor: pointer; }
  .ip6-shipto svg { width: 18px; min-width: 18px; height: 18px; flex-shrink: 0; }
  .ip6-shipto select { position: absolute; inset: 0; width: 100%; opacity: 0; cursor: pointer; font-size: 16px; }
  .ip6-shipto:focus-within { outline: 2px solid #B08830; outline-offset: 2px; }
  .ip6-shipto:hover { color: #7E5A14; }
  @media (max-width: 749px) { .ip6-shipto { padding: 0 4px; } }

  /* Cart page and cart drawer in the store style: square corners, navy button, serif title, hairlines */
  .cart-page__title, .cart-drawer__heading, cart-drawer-component h2 { font-family: "Source Serif 4", Georgia, serif !important; font-weight: 500 !important; color: #001840 !important; letter-spacing: -.01em; }
  .cart-page__title { font-size: clamp(30px, 3.2vw, 44px) !important; }
  .cart__checkout-button.button { background: #001840 !important; color: #fff !important; border: 1px solid #001840 !important; border-radius: 0 !important; min-height: 52px; font-family: "Inter", sans-serif !important; font-size: 14px !important; font-weight: 600 !important; letter-spacing: .06em; text-transform: uppercase; box-shadow: none !important; }
  .cart__checkout-button.button:hover { background: #0C2C5E !important; }
  .cart__checkout-button.button::before, .cart__checkout-button.button::after { border-radius: 0 !important; }
  .cart-page .quantity-selector, cart-drawer-component .quantity-selector, .cart-items .quantity-selector { border-radius: 0 !important; border-color: #C9D1DB !important; }
  .cart-page__summary { border: 0; border-left: 1px solid #E3E7EC; background: #fff !important; }
  @media (max-width: 749px) { .cart-page__summary { border-left: 0; border-top: 1px solid #E3E7EC; } }
  .cart-page .cart-discount input, .cart-page cart-discount-component input, cart-drawer-component cart-discount-component input { border-radius: 0 !important; }
  .cart-page .cart-discount button, cart-discount-component button.button { border-radius: 0 !important; }
  .cart-items__media img, .cart-items .cart-items__media { border-radius: 0 !important; }
  .cart-totals, .cart-page__summary .cart-totals__item { color: #001840; }
  /* Theme sections in the page body sit on the store's white, not the theme's ivory */
  main .section-background { background-color: #fff !important; }
  cart-drawer-component dialog, cart-drawer-component .cart-drawer__dialog, cart-drawer-component .cart-drawer__inner { background: #fff !important; --color-background: 255 255 255; }

  /* Announcement: a thin ivory line with gold type */
  #header-group .announcement-bar, #header-group .announcement-bar .section-background { background: #FBF7EC !important; border: 0 !important; }
  #header-group .announcement-bar { padding: 9px 16px !important; border-bottom: 1px solid #EFE6CF !important; }
  #header-group .announcement-bar, #header-group .announcement-bar * { color: #7E5A14 !important; font-family: "Inter", sans-serif !important; font-size: 12px !important; font-weight: 600 !important; letter-spacing: .1em !important; text-transform: uppercase !important; }
  #header-group .announcement-bar a { text-decoration: underline; text-underline-offset: 3px; }

  /* Sticky FDA line */
  #ip6-disclaimer-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 40; background: #fff; border-top: 1px solid #E3E7EC; font-family: "Inter", sans-serif; color: #001840; }
  #ip6-disclaimer-bar[hidden] { display: none; }
  #ip6-disclaimer-bar .inner { width: min(1240px, calc(100% - 40px)); margin-inline: auto; display: flex; align-items: center; gap: 12px; padding: 8px 0 max(8px, env(safe-area-inset-bottom)); }
  #ip6-disclaimer-bar button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; padding: 0; }
  #ip6-disclaimer-bar .text { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12px; text-align: left; }
  #ip6-disclaimer-bar .tag { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: #7E5A14; flex-shrink: 0; }
  #ip6-disclaimer-bar .copy { flex: 1; min-width: 0; font-size: 12px; color: #4A5A72; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #ip6-disclaimer-bar[data-expanded="true"] .copy { white-space: normal; }
  #ip6-disclaimer-bar .chev { width: 14px; height: 14px; flex-shrink: 0; transition: transform .2s; }
  #ip6-disclaimer-bar[data-expanded="true"] .chev { transform: rotate(180deg); }
  #ip6-disclaimer-bar .close { padding: 6px; }
  #ip6-disclaimer-bar .close svg { width: 14px; height: 14px; display: block; }
</style>
