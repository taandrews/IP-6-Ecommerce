{%- comment -%}
  Inositol ring with six phosphate groups. size: CSS size (default 32px).
  animate: true draws the strokes on when scrolled into view (1.2s).
  Usage: {% render 'ip6-molecule', size: '100%', animate: true %}
{%- endcomment -%}
{%- assign sz = size | default: '32px' -%}
<svg viewBox="0 0 320 320" class="ip6-mol{% if animate %} ip6-mol--anim{% endif %}" style="width:{{ sz }};height:auto;aspect-ratio:1" aria-hidden="true" data-ip6-mol>
  <path d="M160 96 L215.4 128 L215.4 192 L160 224 L104.6 192 L104.6 128 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
  <line x1="160" y1="96" x2="160" y2="32" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="215.4" y1="128" x2="270.9" y2="96" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="215.4" y1="192" x2="270.9" y2="224" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="160" y1="224" x2="160" y2="288" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="104.6" y1="192" x2="49.1" y2="224" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="104.6" y1="128" x2="49.1" y2="96" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <circle cx="160" cy="96" r="7" fill="currentColor"/><circle cx="215.4" cy="128" r="7" fill="currentColor"/><circle cx="215.4" cy="192" r="7" fill="currentColor"/>
  <circle cx="160" cy="224" r="7" fill="currentColor"/><circle cx="104.6" cy="192" r="7" fill="currentColor"/><circle cx="104.6" cy="128" r="7" fill="currentColor"/>
  <circle class="p" cx="160" cy="32" r="14" fill="#C5A253"/><circle class="p" cx="270.9" cy="96" r="14" fill="#C5A253"/><circle class="p" cx="270.9" cy="224" r="14" fill="#C5A253"/>
  <circle class="p" cx="160" cy="288" r="14" fill="#C5A253"/><circle class="p" cx="49.1" cy="224" r="14" fill="#C5A253"/><circle class="p" cx="49.1" cy="96" r="14" fill="#C5A253"/>
</svg>
