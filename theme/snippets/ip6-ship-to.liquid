{%- comment -%}
  "Ship to" country in the header. A native select sits over the compact
  label, so the control is the real select. It only changes what the visitor
  sees; checkout checks the shipping address. Options are filled by ip6-geo.js.
{%- endcomment -%}
<label class="ip6-shipto">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
  <span data-ship-code aria-hidden="true">US</span>
  <span class="visually-hidden">Ship to country</span>
  <select data-ship-to aria-label="Ship to country"><option value="US">United States</option></select>
</label>
