{%- comment -%}
  Contact, from app/contact on ip6original.com. The form is Shopify's contact
  form: messages go to the store's customer email, with the topic and order
  number in the message.
{%- endcomment -%}
<style>
  #ct-{{ section.id }} { font-family: var(--sans); color: var(--ip6-navy); }
  #ct-{{ section.id }} .grid { display: grid; gap: 48px; padding: 64px 0; }
  #ct-{{ section.id }} .ip6-eyebrow { display: block; margin-bottom: 16px; }
  #ct-{{ section.id }} h1 { font-size: clamp(2.6rem, 5vw, 4.5rem); line-height: 1.02; letter-spacing: -.03em; font-weight: 700; margin-bottom: 24px; text-wrap: balance; }
  #ct-{{ section.id }} .lead { font-size: 18px; line-height: 1.65; color: #001840bf; margin-bottom: 32px; }
  #ct-{{ section.id }} dl { display: grid; gap: 16px; font-size: 14px; line-height: 1.65; color: #001840bf; border-top: 1px solid #DCE2E7; padding-top: 24px; }
  #ct-{{ section.id }} dt { font-weight: 600; color: var(--ip6-navy); }
  #ct-{{ section.id }} dd a { text-decoration: underline; color: #1F4A3A; }
  #ct-{{ section.id }} dd ul { margin-top: 4px; display: grid; gap: 4px; }
  #ct-{{ section.id }} .lbl { color: #00184099; }
  #ct-{{ section.id }} .social { display: flex; gap: 20px; margin-top: 4px; }
  #ct-{{ section.id }} .social a { display: inline-flex; min-height: 44px; align-items: center; color: #1F4A3A; text-decoration: none; }
  #ct-{{ section.id }} .social svg { width: 22px; height: 22px; }
  #ct-{{ section.id }} form { background: #fff; border: 1px solid #DCE2E7; border-radius: 8px; box-shadow: 0 1px 3px rgba(0,24,64,.06); padding: 32px; display: grid; gap: 16px; }
  #ct-{{ section.id }} .two { display: grid; gap: 16px; }
  #ct-{{ section.id }} label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 6px; }
  #ct-{{ section.id }} .req { color: #C0392B; }
  #ct-{{ section.id }} input, #ct-{{ section.id }} select, #ct-{{ section.id }} textarea { width: 100%; border: 1px solid #DCE2E7; border-radius: 6px; background: #fff; padding: 12px 14px; font: inherit; font-size: 16px; color: var(--ip6-navy); }
  #ct-{{ section.id }} input:focus, #ct-{{ section.id }} select:focus, #ct-{{ section.id }} textarea:focus { outline: 2px solid var(--ip6-gold-600); outline-offset: 1px; }
  #ct-{{ section.id }} textarea { min-height: 120px; resize: vertical; }
  #ct-{{ section.id }} .hint { margin-top: 6px; font-size: 12px; color: #00184099; }
  #ct-{{ section.id }} .ip6-btn { justify-self: start; padding: 14px 24px; }
  #ct-{{ section.id }} .ok { border-radius: 8px; border: 1px solid #C9DDD2; background: #EEF5F1; padding: 32px; }
  #ct-{{ section.id }} .ok h2 { font-size: 20px; margin-bottom: 8px; }
  #ct-{{ section.id }} .err { color: #B6402F; font-size: 14px; }
  @media (min-width: 640px) { #ct-{{ section.id }} .two { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { #ct-{{ section.id }} .grid { grid-template-columns: 1fr 1.2fr; padding: 96px 0; } }
</style>
<section id="ct-{{ section.id }}" class="ip6"><div class="ip6-wrap grid">
  <div>
    <p class="ip6-eyebrow">Contact</p>
    <h1>We read every message.</h1>
    <p class="lead">For order-specific questions, please include your order number.</p>
    <dl>
      <div><dt>How we reply</dt><dd>By email, to the address you enter, within one business day (Monday to Friday).</dd></div>
      <div><dt>Damaged or incorrect orders</dt><dd>Email <a href="mailto:support@ip6original.com">support@ip6original.com</a> as soon as it arrives with your order number and photos of the item and the packaging so we can review it and make it right.</dd></div>
      <div><dt>Email us directly</dt><dd><ul>
        <li><span class="lbl">Orders and support:</span> <a href="mailto:support@ip6original.com">support@ip6original.com</a></li>
        <li><span class="lbl">Wholesale:</span> <a href="mailto:wholesale@ip6original.com">wholesale@ip6original.com</a></li>
        <li><span class="lbl">Press:</span> <a href="mailto:press@ip6original.com">press@ip6original.com</a></li>
        <li><span class="lbl">Privacy:</span> <a href="mailto:privacy@ip6original.com">privacy@ip6original.com</a></li>
        <li><span class="lbl">Everything else:</span> <a href="mailto:hello@ip6original.com">hello@ip6original.com</a></li>
      </ul></dd></div>
      <div><dt>Follow us</dt><dd><ul class="social">
        <li><a href="https://www.facebook.com/ip6original" target="_blank" rel="noopener noreferrer" aria-label="IP6 Original on Facebook (opens in a new tab)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a></li>
        <li><a href="https://www.instagram.com/ip6original/" target="_blank" rel="noopener noreferrer" aria-label="IP6 Original on Instagram (opens in a new tab)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a></li>
        <li><a href="https://www.youtube.com/@ip6original" target="_blank" rel="noopener noreferrer" aria-label="IP6 Original on YouTube (opens in a new tab)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg></a></li>
      </ul></dd></div>
      <div><dt>After you send</dt><dd>You will see a confirmation on this page straight away. If it does not appear, the message did not go through, so please try again.</dd></div>
    </dl>
  </div>
  {%- form 'contact', id: 'ip6-contact-form' -%}
    {%- if form.posted_successfully? -%}
      <div class="ok" role="status"><h2>Message received.</h2><p>Thank you. We will reply by email within one business day (Monday to Friday).</p></div>
    {%- else -%}
      {%- if form.errors -%}<p class="err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="two">
        <div><label for="c-name">Name <span class="req">*</span></label><input id="c-name" name="contact[name]" required autocomplete="name" value="{{ form.name }}"></div>
        <div><label for="c-email">Email <span class="req">*</span></label><input id="c-email" type="email" name="contact[email]" required autocomplete="email" value="{{ form.email }}"></div>
      </div>
      <div><label for="c-topic">Topic</label><select id="c-topic" name="contact[topic]" required>
        <option>Customer support</option><option>Order question</option><option>Wholesale inquiry</option><option>Press</option><option>Other</option>
      </select></div>
      <div><label for="c-order">Order number</label><input id="c-order" name="contact[order]"><p class="hint">Optional. For order-specific questions.</p></div>
      <div><label for="c-message">Message <span class="req">*</span></label><textarea id="c-message" name="contact[body]" required maxlength="2000"></textarea></div>
      <button type="submit" class="ip6-btn">Send message</button>
    {%- endif -%}
  {%- endform -%}
</div></section>
{% schema %}
{ "name": "IP6 Contact", "tag": "section", "settings": [], "presets": [{ "name": "IP6 Contact" }] }
{% endschema %}
