<style>
 #pg-{{ section.id }} { background: var(--paper); }
 #pg-{{ section.id }} .head { max-width: var(--measure); margin: 0 auto clamp(36px,5vw,56px); text-align: center; }
 #pg-{{ section.id }} .head h1 { margin: 16px 0 0; font-size: clamp(36px,5vw,60px); }
 #pg-{{ section.id }} .rule { width: 56px; height: 1px; background: var(--gold); margin: 28px auto 0; }
 #pg-{{ section.id }} .rte { max-width: var(--measure); margin: 0 auto; }
 #pg-{{ section.id }} .rte h2 { font-family: var(--serif); font-size: clamp(26px,3vw,34px); color: var(--ink); margin: 48px 0 16px; }
 #pg-{{ section.id }} .rte h3 { font-family: var(--serif); font-size: 22px; color: var(--ink); margin: 32px 0 12px; }
 #pg-{{ section.id }} .rte p { font-size: 18px; line-height: 1.7; color: var(--ink-2); margin: 0 0 20px; }
 #pg-{{ section.id }} .rte ul, #pg-{{ section.id }} .rte ol { font-size: 18px; line-height: 1.7; color: var(--ink-2); padding-left: 22px; margin: 0 0 20px; }
 #pg-{{ section.id }} .rte li { margin-bottom: 8px; }
 #pg-{{ section.id }} .rte a { color: var(--ink); border-bottom: 1px solid var(--gold); text-decoration: none; }
 #pg-{{ section.id }} .rte strong { color: var(--ink); }
 #pg-{{ section.id }} .rte blockquote { font-family: var(--serif); font-style: italic; font-size: clamp(22px,2.6vw,30px); line-height: 1.3; color: var(--ink); border: 0; margin: 36px 0; padding: 0; }
 #pg-{{ section.id }} .rte table { width: 100%; border-collapse: collapse; margin: 28px 0; font-size: 15.5px; }
 #pg-{{ section.id }} .rte th { text-align: left; font-family: var(--sans); font-weight: 700; color: var(--ink); padding: 14px 16px; border-bottom: 2px solid var(--ink); font-size: 14px; }
 #pg-{{ section.id }} .rte td { padding: 14px 16px; border-bottom: 1px solid var(--line); color: var(--ink-2); vertical-align: top; }
 #pg-{{ section.id }} .rte tr td:first-child, #pg-{{ section.id }} .rte th:first-child { font-weight: 600; color: var(--ink); }
 #pg-{{ section.id }} .rte td:last-child { background: #f7fafe; }
</style>
<section id="pg-{{ section.id }}" class="ip6 ip6-section ip6-reveal">
 <div class="ip6-wrap">
 <div class="head ip6-rise d1">
 <span class="ip6-eyebrow">{{ page.metafields.custom.eyebrow | default: section.settings.eyebrow | default: 'IP6 Original' }}</span>
 <h1 class="ip6-display">{{ page.title }}</h1>
 <div class="rule"></div>
 </div>
 <div class="rte ip6-rise d2">
 {{ page.content }}
 </div>
 </div>
</section>
{% schema %}
{
 "name": "IP6 Page",
 "tag": "section",
 "settings": [ { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "IP6 Original" } ],
 "presets": [{ "name": "IP6 Page" }]
}
{% endschema %}
