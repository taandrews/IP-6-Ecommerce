{%- comment -%}
  Plain pages (legal pages, international shipping), laid out like the legal
  pages on ip6original.com: eyebrow, title, then the page body.
{%- endcomment -%}
<style>
  #pg-{{ section.id }} { font-family: var(--sans); color: var(--ip6-navy); }
  #pg-{{ section.id }} .inner { width: min(768px, calc(100% - 2 * var(--gutter))); margin-inline: auto; padding: 64px 0; }
  #pg-{{ section.id }} .ip6-eyebrow { display: block; margin-bottom: 12px; }
  #pg-{{ section.id }} h1 { font-size: clamp(2.6rem, 5vw, 4.5rem); line-height: 1.02; letter-spacing: -.03em; font-weight: 700; margin-bottom: 12px; color: #1F4A3A; }
  #pg-{{ section.id }} .rte { line-height: 1.7; color: #001840cc; }
  #pg-{{ section.id }} .rte > p:first-child { font-size: 14px; color: #00184099; margin-bottom: 32px; }
  #pg-{{ section.id }} .rte h2 { font-size: clamp(1.4rem, 2.2vw, 1.75rem); line-height: 1.2; color: #1F4A3A; font-weight: 600; margin: 32px 0 12px; }
  #pg-{{ section.id }} .rte h3 { font-size: 18px; font-weight: 600; color: var(--ip6-navy); margin: 24px 0 8px; }
  #pg-{{ section.id }} .rte p { margin: 0 0 12px; }
  #pg-{{ section.id }} .rte ul, #pg-{{ section.id }} .rte ol { padding-left: 22px; margin: 0 0 12px; list-style: disc; }
  #pg-{{ section.id }} .rte li + li { margin-top: 6px; }
  #pg-{{ section.id }} .rte a { color: #1F4A3A; text-decoration: underline; }
  #pg-{{ section.id }} .rte strong { color: var(--ip6-navy); font-weight: 600; }
  #pg-{{ section.id }} .rte table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px; }
  #pg-{{ section.id }} .rte th { text-align: left; padding: 8px 16px 8px 0; border-bottom: 1px solid #DCE2E7; }
  #pg-{{ section.id }} .rte td { padding: 8px 16px 8px 0; border-bottom: 1px solid #EEF1F4; vertical-align: top; }
  #pg-{{ section.id }} .rte .ip6-btn { color: #fff; text-decoration: none; }
</style>
<section id="pg-{{ section.id }}" class="ip6"><div class="inner">
  <p class="ip6-eyebrow">{{ page.metafields.custom.eyebrow | default: 'Legal' }}</p>
  <h1>{{ page.title }}</h1>
  <div class="rte">{{ page.content }}</div>
</div></section>
{% schema %}
{ "name": "IP6 Page", "tag": "section", "settings": [], "presets": [{ "name": "IP6 Page" }] }
{% endschema %}
