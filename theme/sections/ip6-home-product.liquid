{%- liquid
 assign product = section.settings.product | default: all_products['ip-6-original']
 assign cv = product.selected_or_first_available_variant
 assign has_plans = false
 if product.selling_plan_groups.size > 0
 assign has_plans = true
 endif
 assign sub = cv.price | times: 0.85 | round
 assign ip6_mg = cv.metafields.ip6.ip6_mg.value | default: 804
 assign ino_mg = cv.metafields.ip6.inositol_mg.value | default: 196
 assign servings = cv.metafields.ip6.servings.value | default: 60
-%}
<style>
 #hp-{{ section.id }} { background: var(--paper); color: var(--ink); }
 #hp-{{ section.id }} .g { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 6vw, 80px); }
 #hp-{{ section.id }} .main { aspect-ratio: 4/5; border: 1px solid rgba(11,31,58,.1); border-radius: 16px; display: grid; place-items: center; overflow: hidden; background: var(--paper); }
 #hp-{{ section.id }} .main img { width: 80%; height: 80%; object-fit: contain; }
 #hp-{{ section.id }} .main img.cover { width: 100%; height: 100%; object-fit: cover; }
 #hp-{{ section.id }} .thumbs { display: flex; gap: 12px; margin-top: 16px; list-style: none; padding: 0; }
 #hp-{{ section.id }} .thumbs button { width: 80px; height: 80px; border-radius: 8px; border: 1px solid rgba(11,31,58,.15); background: var(--paper); padding: 6px; cursor: pointer; }
 #hp-{{ section.id }} .thumbs button[aria-pressed="true"] { border-color: var(--ink); }
 #hp-{{ section.id }} .thumbs img { width: 100%; height: 100%; object-fit: contain; }
 #hp-{{ section.id }} .buy { display: flex; flex-direction: column; justify-content: center; }
 #hp-{{ section.id }} h2 { margin: 20px 0 0; }
 #hp-{{ section.id }} .desc { font-family: var(--serif); font-size: 18px; line-height: 1.6; color: rgba(11,31,58,.8); margin: 20px 0 0; }
 #hp-{{ section.id }} .specs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1px; background: rgba(11,31,58,.15); border: 1px solid rgba(11,31,58,.15); border-radius: 12px; overflow: hidden; margin: 32px 0 0; }
 #hp-{{ section.id }} .specs div { background: var(--paper); padding: 16px 12px; }
 #hp-{{ section.id }} .specs dt { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: rgba(11,31,58,.55); }
 #hp-{{ section.id }} .specs dd { margin: 4px 0 0; font-family: var(--mono); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
 #hp-{{ section.id }} .price { display: flex; align-items: baseline; gap: 12px; margin: 32px 0 0; }
 #hp-{{ section.id }} .price .now { font-family: var(--serif); font-size: 40px; line-height: 1; font-variant-numeric: tabular-nums; }
 #hp-{{ section.id }} .price .was { color: rgba(11,31,58,.5); text-decoration: line-through; }
 #hp-{{ section.id }} .price .pct { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-deep); }
 #hp-{{ section.id }}[data-mode="onetime"] .price .was, #hp-{{ section.id }}[data-mode="onetime"] .price .pct { display: none; }
 #hp-{{ section.id }} .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 12px 0 0; }
 #hp-{{ section.id }} .plan { display: flex; gap: 12px; align-items: flex-start; border: 1px solid rgba(11,31,58,.2); border-radius: 12px; padding: 16px; cursor: pointer; transition: all .15s; }
 #hp-{{ section.id }} .plan[data-active="true"] { background: var(--ink); color: #F6F2EA; border-color: var(--ink); }
 #hp-{{ section.id }} .plan .dot { width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(11,31,58,.4); margin-top: 3px; flex: none; display: grid; place-items: center; }
 #hp-{{ section.id }} .plan[data-active="true"] .dot { border-color: var(--gold); }
 #hp-{{ section.id }} .plan[data-active="true"] .dot::after { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); }
 #hp-{{ section.id }} .plan .title { font-weight: 500; display: block; }
 #hp-{{ section.id }} .plan .note { font-size: 12px; opacity: .7; display: block; margin-top: 2px; }
 #hp-{{ section.id }} .ph { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: rgba(11,31,58,.5); margin: 8px 0 0; }
 #hp-{{ section.id }} .actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 28px; }
 /* Mobile sticky bar */
 #hpbar-{{ section.id }} { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: rgba(246,242,234,.96); backdrop-filter: blur(8px); border-top: 1px solid rgba(11,31,58,.1); transform: translateY(110%); transition: transform .3s ease-out; padding-bottom: env(safe-area-inset-bottom, 0); }
 #hpbar-{{ section.id }}.is-on { transform: none; }
 #hpbar-{{ section.id }} .in { display: flex; align-items: center; gap: 12px; height: 64px; }
 #hpbar-{{ section.id }} .t { flex: 1; min-width: 0; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 #hpbar-{{ section.id }} .p { font-family: var(--serif); font-size: 20px; flex: none; }
 #hpbar-{{ section.id }} .ip6-btn { padding: 12px 20px; font-size: 12px; flex: none; }
 @media (min-width: 1024px) { #hpbar-{{ section.id }} { display: none; } }
 @media (max-width: 749px) { #hp-{{ section.id }} .g { grid-template-columns: 1fr; gap: 36px; } #hp-{{ section.id }} .specs { grid-template-columns: repeat(3, 1fr); } #hp-{{ section.id }} .plans { grid-template-columns: 1fr; } }
</style>
<section id="hp-{{ section.id }}" class="ip6 ip6-section ip6-reveal" data-ip6-pdp data-onetime="{{ cv.price }}" data-mode="subscribe" data-hp-root>
 <div class="ip6-wrap g">
 <div class="ip6-rise d1">
 <div class="main">
 {%- if product.featured_image -%}
 <img data-main-img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title }}" width="640" height="800" loading="lazy">
 {%- else -%}
 <img data-main-img src="{{ 'ip6-bottle-front.png' | asset_url }}" alt="IP6 Original" width="640" height="800" loading="lazy">
 {%- endif -%}
 </div>
 {%- assign extra = section.blocks | where: "type", "macro" -%}
 {%- if product.images.size > 1 or extra.size > 0 -%}
 <ol class="thumbs" aria-label="Product images">
 {%- for image in product.images -%}
 {%- assign src_l = image.src | downcase -%}{%- if src_l contains 'back' -%}{%- continue -%}{%- endif -%}
 <li><button type="button" aria-label="Show image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-src="{{ image | image_url: width: 1000 }}"><img src="{{ image | image_url: width: 200 }}" alt="" width="80" height="80" loading="lazy"></button></li>
 {%- endfor -%}
 {%- for b in extra -%}{%- if b.settings.image != blank -%}
 <li {{ b.shopify_attributes }}><button type="button" aria-label="Show macro shot {{ forloop.index }}" aria-pressed="false" data-cover data-src="{{ b.settings.image | image_url: width: 1200 }}"><img src="{{ b.settings.image | image_url: width: 200 }}" alt="" width="80" height="80" loading="lazy"></button></li>
 {%- endif -%}{%- endfor -%}
 </ol>
 {%- endif -%}
 </div>

 <div class="buy ip6-rise d2">
 <span class="ip6-eyebrow">The solution</span>
 <h2 class="ip6-h2">{{ product.title | default: 'IP6 Original' }}</h2>
 <p class="desc">The original IP6 formula, a high-purity blend of IP6 and Inositol, formulated by the physician-scientist who pioneered the research behind it.</p>
 <dl class="specs">
 <div><dt>Capsules</dt><dd>120</dd></div>
 <div><dt>Servings</dt><dd><span data-spec-servings>{{ servings }}</span></dd></div>
 <div><dt>IP6</dt><dd><span data-spec-ip6>{{ ip6_mg }}</span> mg</dd></div>
 <div><dt>Inositol</dt><dd><span data-spec-inositol>{{ ino_mg }}</span> mg</dd></div>
 <div><dt>Certified</dt><dd>cGMP</dd></div>
 <div><dt>Tested</dt><dd>Third-party</dd></div>
 </dl>
 <p class="price"><span class="now" data-atc>{{ sub | money }}</span><span class="was" data-ot-now>{{ cv.price | money }}</span><span class="pct" data-pct>Save 15%</span></p>
 <form method="post" action="{{ routes.cart_add_url }}" id="hpform-{{ section.id }}">
 <input type="hidden" name="id" data-vid-input value="{{ cv.id }}">
 <input type="hidden" name="selling_plan" data-plan-input value="" disabled>
 <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
 <p class="ip6-eyebrow" style="margin-top:24px">Purchase</p>
 <div class="plans" role="radiogroup" aria-label="Purchase option">
 <label class="plan" data-plan="subscribe" data-discount="15" data-cycle="30"{% if has_plans %} data-selling-plan="{{ product.selling_plan_groups.first.selling_plans.first.id }}"{% endif %} data-active="true" role="radio" aria-checked="true" tabindex="0"><span class="dot"></span><span><span class="title">Subscribe &amp; save</span><span class="note">Every 30 days · 15% off · cancel anytime</span></span></label>
 <label class="plan" data-plan="onetime" data-active="false" role="radio" aria-checked="false" tabindex="0"><span class="dot"></span><span><span class="title">One-time purchase</span><span class="note" data-ot-now>{{ cv.price | money }}</span></span></label>
 </div>
 {%- unless has_plans -%}<p class="ph">Subscribe pricing is a placeholder until Recharge is connected.</p>{%- endunless -%}
 <div class="actions">
 <button type="submit" class="ip6-btn ip6-btn--gold" data-atc-anchor>Add to cart</button>
 <a class="ip6-btn ip6-btn--outline-navy" href="{{ product.url }}">Full details</a>
 </div>
 </form>
 </div>
 </div>

 <div id="hpbar-{{ section.id }}" data-buybar aria-hidden="true">
 <div class="ip6-wrap in">
 <p class="t">{{ product.title | default: 'IP6 Original' }}</p>
 <span class="p" data-atc>{{ sub | money }}</span>
 <button type="submit" form="hpform-{{ section.id }}" class="ip6-btn ip6-btn--gold">Add</button>
 </div>
 </div>
</section>
<script src="{{ 'ip6-pdp.js' | asset_url }}" defer></script>
<script>
(function(){
 var root = document.getElementById('hp-{{ section.id }}'); if(!root) return;
 var main = root.querySelector('[data-main-img]');
 root.querySelectorAll('.thumbs button').forEach(function(t){ t.addEventListener('click', function(){ if(main){ main.classList.toggle('cover', t.hasAttribute('data-cover')); } }); });
})();
</script>
{% schema %}
{
 "name": "IP6 Home Product",
 "tag": "section",
 "settings": [ { "type": "product", "id": "product", "label": "Product" } ],
 "blocks": [ { "type": "macro", "name": "Macro shot", "settings": [ { "type": "image_picker", "id": "image", "label": "Macro image (4:5)" } ] } ],
 "presets": [{ "name": "IP6 Home Product" }]
}
{% endschema %}
