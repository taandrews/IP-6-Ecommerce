<style>
  #proof-{{ section.id }} { background: var(--ink); color: #fff; }
  #proof-{{ section.id }} .ip6-eyebrow { color: var(--gold); }
  #proof-{{ section.id }} h2 { color: #fff; }
  #proof-{{ section.id }} .top { max-width: 720px; margin-bottom: clamp(40px, 5vw, 64px); }
  #proof-{{ section.id }} .top h2 { margin-top: 14px; }
  #proof-{{ section.id }} .list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px 40px; }
  #proof-{{ section.id }} .n { font-family: var(--sans); font-size: clamp(44px, 4.5vw, 64px); line-height: 1; letter-spacing: -0.03em; font-weight: 400; color: var(--gold); font-variant-numeric: tabular-nums; white-space: nowrap; }
  #proof-{{ section.id }} .n small { font-size: .4em; font-weight: 500; letter-spacing: 0; color: rgba(255,255,255,.6); margin-left: 4px; }
  #proof-{{ section.id }} .rule { display: block; border: 0; border-top: 1px dotted rgba(255,255,255,.35); margin: 20px 0 16px; }
  #proof-{{ section.id }} .l { font-weight: 600; color: #fff; margin: 0; font-size: 16px; }
  #proof-{{ section.id }} .d { margin: 8px 0 0; font-size: 14.5px; line-height: 1.55; color: rgba(255,255,255,.65); }
  @media (max-width: 900px) { #proof-{{ section.id }} .list { grid-template-columns: 1fr 1fr; gap: 40px 28px; } }
  @media (max-width: 520px) { #proof-{{ section.id }} .list { grid-template-columns: 1fr; } }
</style>
<section id="proof-{{ section.id }}" class="ip6 ip6-bright ip6-section ip6-reveal">
  <div class="ip6-wrap">
    <div class="top ip6-rise d1">
      <span class="ip6-eyebrow">The proof</span>
      <h2 class="ip6-h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="list">
      <div class="ip6-rise d1">
        <p class="n">1998</p>
        <hr class="rule">
        <p class="l">First paper</p>
        <p class="d">Prof. Shamsuddin publishes his first paper on inositol hexaphosphate at the University of Maryland School of Medicine.</p>
      </div>
      <div class="ip6-rise d2">
        <p class="n">1,000<small>mg</small></p>
        <hr class="rule">
        <p class="l">Per serving</p>
        <p class="d">804 mg IP6 and 196 mg Inositol in every 2-capsule serving, the pairing his research describes.</p>
      </div>
      <div class="ip6-rise d3">
        <p class="n">0</p>
        <hr class="rule">
        <p class="l">Processing additives</p>
        <p class="d">No magnesium stearate, no silicon dioxide. A plant-based cellulose capsule and nothing else.</p>
      </div>
      <div class="ip6-rise d4">
        <p class="n">1</p>
        <hr class="rule">
        <p class="l">Named formulator</p>
        <p class="d">One supplement, formulated by the scientist behind the research, made in a cGMP-certified facility and third-party tested.</p>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "IP6 Proof",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to the standard the research describes." },
    { "type": "url", "id": "link", "label": "Founder link (unused, kept for existing settings)" }
  ],
  "presets": [{ "name": "IP6 Proof" }]
}
{% endschema %}
