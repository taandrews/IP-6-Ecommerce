<style>
  #hf-{{ section.id }} { background: var(--paper); color: var(--ink); }
  #hf-{{ section.id }} .g { display: grid; grid-template-columns: 1fr 1fr; }
  #hf-{{ section.id }} .photo { position: relative; min-height: 720px; background: var(--surface); }
  #hf-{{ section.id }} .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  #hf-{{ section.id }} .photo video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #hf-{{ section.id }} .copy { display: flex; align-items: center; padding: 120px clamp(24px, 6vw, 96px); }
  #hf-{{ section.id }} blockquote { font-family: var(--serif); font-style: italic; font-size: clamp(28px, 2.8vw, 40px); line-height: 1.2; letter-spacing: -0.01em; margin: 24px 0 0; }
  #hf-{{ section.id }} h2 { font-size: clamp(22px, 1.8vw, 26px); font-weight: 500; margin: 32px 0 0; }
  #hf-{{ section.id }} .bio { font-size: 18px; line-height: 1.6; color: rgba(11,31,58,.75); margin: 12px 0 0; max-width: 56ch; }
  #hf-{{ section.id }} .link { margin-top: 36px; }
  @media (max-width: 749px) { #hf-{{ section.id }} .g { grid-template-columns: 1fr; } #hf-{{ section.id }} .photo { min-height: 420px; } #hf-{{ section.id }} .copy { padding: 72px var(--gutter); } }
</style>
<section id="hf-{{ section.id }}" class="ip6 ip6-reveal">
  <div class="g">
    <div class="photo ip6-rise d1">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="Portrait of Professor AbulKalam M. Shamsuddin, MD, PhD, founder and formulator of IP6 Original." width="720" height="900" loading="lazy">
      {%- else -%}
        <img src="{{ 'ip6-founder.jpg' | asset_url }}" alt="Portrait of Professor AbulKalam M. Shamsuddin, MD, PhD, founder and formulator of IP6 Original." width="720" height="900" loading="lazy">
      {%- endif -%}
    </div>
    <div class="copy">
      <div class="ip6-rise d2">
        <span class="ip6-eyebrow">The founder</span>
        <blockquote>&ldquo;IP6 Original is the supplement built to the specification his own research describes.&rdquo;</blockquote>
        <h2>Prof. AbulKalam M. Shamsuddin, MD, PhD</h2>
        <p class="bio">A physician-scientist who has spent his career at the University of Maryland School of Medicine researching the health properties of inositol hexaphosphate, and a pioneer of the published research on the molecule. He formulated IP6 Original to bring the product of that research directly to consumers.</p>
        <p class="link"><a class="ip6-btn ip6-btn--outline-navy" href="{{ section.settings.link | default: '/pages/story#founder' }}">Meet Prof. Shamsuddin</a></p>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "IP6 Home Founder",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder portrait (4:5)" },
    { "type": "video", "id": "video", "label": "Founder video (optional, plays muted in place of the portrait)" },
    { "type": "url", "id": "link", "label": "Founder page link" }
  ],
  "presets": [{ "name": "IP6 Home Founder" }]
}
{% endschema %}
