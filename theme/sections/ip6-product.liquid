{%- comment -%}
  Product page: gallery of the product's photos (packshot first), then price
  and buy controls, the key facts, and the details as accordions. On phones a
  bar with the price and Add to cart stays at the bottom once the buy box
  scrolls away. Copy per product is the wording on ip6original.com.
{%- endcomment -%}
{%- liquid
  assign pet = false
  if product.handle == 'ip6-original-pet-powder'
    assign pet = true
  endif
  assign v = product.selected_or_first_available_variant
  assign pct = settings.ip6_preorder_pct | default: 15
  if settings.ip6_preorder_active and pct > 0
    assign keep = 100 | minus: pct
    assign now = v.price | times: keep | divided_by: 100.0 | round
  else
    assign now = v.price
  endif
-%}
<style>
  .p-top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; padding: 32px 0 72px; align-items: start; }
  .p-crumb { font-size: 13px; color: var(--faint); padding-top: 24px; }
  .p-crumb a:hover { color: var(--navy); }
  .p-main { aspect-ratio: 1 / 1; border: 1px solid var(--rule); background: #fff; }
  .p-main img { width: 100%; height: 100%; object-fit: contain; }
  .p-top > * { min-width: 0; }
  .p-thumbs { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; margin-top: 8px; }
  .p-thumbs button { aspect-ratio: 1 / 1; border: 1px solid var(--rule); background: #fff; overflow: hidden; }
  .p-thumbs button[aria-pressed="true"] { border-color: var(--navy); }
  .p-thumbs img { width: 100%; height: 100%; object-fit: cover; }
  .p-info { position: sticky; top: 96px; }
  .p-info .s-kicker { display: block; margin-bottom: 12px; }
  .p-info h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(34px, 3.4vw, 46px); line-height: 1.08; margin-bottom: 14px; }
  .p-info .s-lead { margin-bottom: 24px; font-size: 17px; }
  .p-info .s-buy { padding: 24px 0; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); margin-bottom: 24px; }
  .p-keys { display: grid; gap: 10px; margin-bottom: 28px; }
  .p-keys li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; font-size: 15px; line-height: 1.5; color: var(--muted); }
  .p-keys svg { width: 18px; height: 18px; color: var(--gold); margin-top: 2px; }
  .p-label { display: block; border: 1px solid var(--rule); padding: 8px; margin-top: 4px; }
  .p-sticky { display: none; }
  @media (max-width: 989px) {
    .p-top { grid-template-columns: 1fr; gap: 28px; padding: 16px 0 56px; }
    .p-info { position: static; }
    .p-thumbs { gap: 6px; }
    .p-sticky { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 45; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px max(10px, env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid var(--rule-strong); transform: translateY(110%); transition: transform .2s; }
    .p-sticky.show { transform: none; }
    .p-sticky .t { font-size: 13px; font-weight: 600; }
    .p-sticky .pr { font-family: var(--serif); font-size: 20px; }
    .p-sticky .s-btn { min-height: 44px; padding: 0 18px; }
  }
</style>
{%- capture check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
<div class="s">
  <div class="s-wrap">
    <nav class="p-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.collections_url }}/shop">Shop</a> / <span>{{ product.title }}</span></nav>
    <div class="p-top">
      <div data-gallery>
        <div class="p-main">
          {%- assign first = product.featured_image -%}
          <img data-main src="{{ first | image_url: width: 1400 }}" alt="{{ first.alt | escape }}" width="{{ first.width }}" height="{{ first.height }}" fetchpriority="high">
        </div>
        {%- if product.images.size > 1 -%}
          <div class="p-thumbs" role="group" aria-label="{{ product.title }} photos">
            {%- for img in product.images -%}
              <button type="button" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show photo {{ forloop.index }} of {{ product.images.size }}" data-src="{{ img | image_url: width: 1400 }}" data-alt="{{ img.alt | escape }}"><img src="{{ img | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="p-info">
        <span class="s-kicker">{% if pet %}For dogs &amp; cats{% else %}For people{% endif %}</span>
        <h1>{{ product.title }}</h1>
        <p class="s-lead">{% if pet %}Unflavored IP6 and Inositol powder for dogs and cats.{% else %}IP6 and Inositol in vegetable capsules.{% endif %}</p>
        <div data-buybox>{% render 'ip6-buy', product: product %}</div>
        <ul class="p-keys">
          {%- if pet -%}
            <li>{{ check }}804 mg IP6 and 196 mg Inositol per 1 g level scoop</li>
            <li>{{ check }}Unflavored, easy to mix into food</li>
            <li>{{ check }}cGMP-certified, third-party tested, veterinarian formulated</li>
            <li>{{ check }}Measuring scoop included</li>
          {%- else -%}
            <li>{{ check }}804 mg IP6 and 196 mg Inositol per 4-capsule serving</li>
            <li>{{ check }}High-Purity Formula, third-party tested</li>
            <li>{{ check }}Formulated by Professor Shamsuddin, founder and formulator</li>
            <li>{{ check }}No magnesium stearate, no silicon dioxide, no unnecessary additives</li>
          {%- endif -%}
        </ul>
        <div class="s-acc">
          {%- if pet -%}
            <details open><summary>Ingredients</summary><div class="a"><ul><li>IP6 (Inositol Hexaphosphate), 804 mg per 1 g level scoop</li><li>Inositol, 196 mg per scoop</li><li>Other ingredients: none</li></ul></div></details>
            <details><summary>Feeding directions</summary><div class="a"><ol><li>Dogs up to 25 lb: 1 level scoop once daily.</li><li>Dogs 26 to 50 lb: 1 level scoop twice daily.</li><li>Dogs over 50 lb: 2 level scoops twice daily.</li><li>Cats: 1 level scoop once daily.</li><li>Use the enclosed measuring scoop and mix into your pet's food.</li></ol></div></details>
            <details><summary>Product details</summary><div class="a"><p>The original IP6 formula, for pets, in an easy-to-mix powder. IP6 and Inositol for dogs and cats, for single and multi-pet households.</p><ul><li>No magnesium stearate, no silicon dioxide, no unnecessary additives</li><li>Made in USA</li></ul></div></details>
            <details><summary>Frequently asked questions</summary><div class="a">
              <p><strong>How much do I give my pet?</strong><br>Dogs up to 25 lb: 1 level scoop once daily. Dogs 26 to 50 lb: 1 level scoop twice daily. Dogs over 50 lb: 2 level scoops twice daily. Cats: 1 level scoop once daily. Use the enclosed measuring scoop.</p>
              <p><strong>What is in each scoop?</strong><br>Each 1 g level scoop contains 804 mg IP6 and 196 mg Inositol. There are no other ingredients.</p>
              <p><strong>Is it flavored?</strong><br>No. It is unflavored and easy to mix into food.</p>
              <p><strong>Is it third-party tested?</strong><br>Yes. IP6 Original Pet Powder is made in a cGMP-certified facility and third-party tested.</p>
            </div></details>
          {%- else -%}
            <details open><summary>Ingredients &amp; Supplement Facts</summary><div class="a"><ul><li>IP6 (Calcium Magnesium Inositol Hexaphosphate), 804 mg per 4-capsule serving</li><li>Inositol, 196 mg per serving</li><li>Other ingredients: hypromellose (vegetable capsule)</li></ul>
              <a class="p-label" href="{{ settings.ip6_cdn }}/products/supplement-240-label.jpg" target="_blank" rel="noopener noreferrer"><img src="{{ settings.ip6_cdn }}/products/supplement-240-label.jpg" alt="IP6 Original 240-count label with Supplement Facts" width="1600" height="622" loading="lazy"></a></div></details>
            <details><summary>How to take</summary><div class="a"><ol><li>Take 4 capsules once or twice daily with water, or as directed by your healthcare professional.</li><li>Consult a healthcare professional before starting any supplement regimen.</li></ol><p><a class="s-link" href="/pages/how-to-take">Full directions</a></p></div></details>
            <details><summary>Product details</summary><div class="a"><p>The original IP6 formula, a high-purity blend of IP6 and Inositol, formulated by the physician-scientist who pioneered the research behind it.</p><ul><li>Manufactured in a cGMP-certified facility</li><li>Hypromellose (vegetable) capsule</li><li>240 capsules, 60 servings</li></ul></div></details>
            <details><summary>Frequently asked questions</summary><div class="a">
              <p><strong>What is IP6?</strong><br>IP6 (inositol hexaphosphate) is a naturally occurring compound found in whole grains, legumes, and seeds. IP6 Original pairs it with Inositol in a high-purity formula, third-party tested for purity, potency, and quality.</p>
              <p><strong>Is this product third-party tested?</strong><br>Yes. IP6 Original is independently third-party tested for purity, potency, and quality.</p>
              <p><strong>Can I take IP6 with other supplements?</strong><br>IP6 is commonly taken alongside other wellness routines. We recommend consulting your healthcare professional to coordinate any supplement stack.</p>
            </div></details>
          {%- endif -%}
          <details><summary>Shipping &amp; returns</summary><div class="a"><p>{{ settings.ip6_preorder_ship | default: 'Starts shipping November 2026' }}, in the order received, with a tracking email the day it ships. Ships to US addresses only (the 50 states and Washington, DC). Free shipping over $75. All sales are final once shipped.</p><p><a class="s-link" href="/pages/shipping-policy">Shipping policy</a></p></div></details>
        </div>
      </div>
    </div>
  </div>
  {% render 'ip6-reviews', product: product %}
  <p class="s-wrap s-dshea">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
  <div class="p-sticky s" data-sticky data-buy-only aria-hidden="true">
    <div><div class="t">{{ product.title }}</div><div class="pr">{{ now | money }}</div></div>
    <button type="button" class="s-btn" data-sticky-add>Add to cart</button>
  </div>
</div>
{% render 'ip6-trust' %}
<script src="{{ 'ip6-buy.js' | asset_url }}" defer></script>
<script>
  (function () {
    var g = document.querySelector('[data-gallery]');
    if (g) { var main = g.querySelector('[data-main]'); g.querySelectorAll('[data-src]').forEach(function (b) { b.addEventListener('click', function () { main.src = b.getAttribute('data-src'); main.alt = b.getAttribute('data-alt'); g.querySelectorAll('[data-src]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); }); }); }); }
    var bar = document.querySelector('[data-sticky]'), box = document.querySelector('[data-buybox]');
    if (bar && box && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { var show = !e[0].isIntersecting && e[0].boundingClientRect.top < 0; bar.classList.toggle('show', show); bar.setAttribute('aria-hidden', show ? 'false' : 'true'); }).observe(box);
      bar.querySelector('[data-sticky-add]').addEventListener('click', function () { var a = box.querySelector('[data-add]'); if (a) a.click(); var b = this; b.textContent = 'Added'; setTimeout(function () { b.textContent = 'Add to cart'; }, 1800); });
    }
  })();
</script>
{% schema %}
{ "name": "IP6 Product", "tag": "section", "settings": [] }
{% endschema %}
