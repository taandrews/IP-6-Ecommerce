{%- comment -%} Shop: heading, the two products as cards with price and Add to cart, the standards. {%- endcomment -%}
{%- assign cdn = settings.ip6_cdn -%}
<style>
  .c-head { padding: 56px 0 32px; border-bottom: 1px solid var(--rule-strong); margin-bottom: 40px; display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .c-head .s-kicker { display: block; margin-bottom: 12px; }
  .c-head .s-lead { max-width: 44ch; }
  .c-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-bottom: 72px; }
  .c-card .s-shot { aspect-ratio: 1 / 1; margin-bottom: 24px; position: relative; }
  .c-card .s-shot img { width: 62%; height: 86%; }
  .c-card .s-shot .flag { position: absolute; top: 16px; left: 16px; font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-ink); border: 1px solid var(--gold); background: #fff; padding: 5px 9px; }
  .c-card .s-kicker { display: block; margin-bottom: 8px; }
  .c-card .s-h3 { font-size: 28px; margin-bottom: 8px; }
  .c-card .s-body { margin-bottom: 20px; }
  .c-card .meta { font-size: 13px; color: var(--faint); margin-bottom: 16px; }
  @media (max-width: 749px) { .c-head { display: block; padding: 32px 0 24px; } .c-head .s-lead { margin-top: 12px; } .c-grid { grid-template-columns: 1fr; gap: 48px; } }
</style>
<div class="s">
  <div class="s-wrap">
    <header class="c-head">
      <div><span class="s-kicker">Shop</span><h1 class="s-h1">Choose your formula.</h1></div>
      <p class="s-lead">The original IP6 and Inositol formula. In capsules for you, a powder for them.</p>
    </header>
    <div class="c-grid">
      {%- assign handles = 'ip-6-original,ip6-original-pet-powder' | split: ',' -%}
      {%- for h in handles -%}
        {%- assign p = all_products[h] -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          if h == 'ip6-original-pet-powder'
            assign img = cdn | append: '/products/pet-powder-120g.png'
            assign label = 'For dogs & cats'
            assign desc = 'Unflavored IP6 and Inositol powder, easy to mix into food for dogs and cats.'
            assign meta = '120 g · 1 g level scoop · measuring scoop included'
            assign anchor = 'pets'
          else
            assign img = cdn | append: '/products/supplement-240.png'
            assign label = 'For people'
            assign desc = 'The original IP6 and Inositol formula in vegetable capsules for your daily routine.'
            assign meta = '240 capsules · 4 capsules per serving · 60 servings'
            assign anchor = 'people'
          endif
        -%}
        <article class="c-card" id="{{ anchor }}" aria-labelledby="cc-{{ forloop.index }}">
          <a href="{{ p.url }}" class="s-shot" aria-label="View {{ p.title }}">{% if settings.ip6_preorder_active %}<span class="flag">{{ settings.ip6_preorder_pct }}% launch offer</span>{% endif %}<img src="{{ img }}" alt="{{ p.title }}" width="870" height="1160" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}></a>
          <span class="s-kicker">{{ label }}</span>
          <h2 id="cc-{{ forloop.index }}" class="s-h3"><a href="{{ p.url }}">{{ p.title }}</a></h2>
          <p class="s-body">{{ desc }}</p>
          <p class="meta">{{ meta }}</p>
          {% render 'ip6-buy', product: p, compact: true %}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>
{% render 'ip6-trust' %}
<script src="{{ 'ip6-buy.js' | asset_url }}" defer></script>
{% schema %}
{ "name": "IP6 Collection", "tag": "section", "settings": [] }
{% endschema %}
