{%- comment -%} The Story: the founder, the research timeline and the formula. Words from ip6original.com. {%- endcomment -%}
{%- assign cdn = settings.ip6_cdn -%}
{%- capture arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>{%- endcapture -%}
<style>
  .st-open { padding: 56px 0 72px; border-bottom: 1px solid var(--rule); }
  .st-open .s-kicker { display: block; margin-bottom: 18px; }
  .st-open .s-h1 { max-width: 18ch; margin-bottom: 48px; }
  .st-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 64px; align-items: center; }
  .st-grid figure img { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; object-position: top; border: 1px solid var(--rule); }
  .st-grid figcaption { margin-top: 10px; font-size: 12px; color: var(--faint); }
  .st-grid h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(28px, 2.8vw, 38px); line-height: 1.15; margin: 12px 0 6px; }
  .st-grid .cred { font-size: 14px; letter-spacing: .06em; color: var(--faint); margin-bottom: 24px; }
  .st-grid .quoteish { font-family: var(--serif); font-style: italic; font-size: 24px; line-height: 1.4; margin-bottom: 18px; max-width: 30ch; }
  .st-grid .s-body + .s-body { margin-top: 12px; }
  .st-time { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 64px; align-items: start; }
  .st-time .intro { position: sticky; top: 112px; }
  .st-time ol li { display: grid; grid-template-columns: 180px 1fr; gap: 24px; padding: 28px 0; border-top: 1px solid var(--rule-strong); }
  .st-time ol li:last-child { border-bottom: 1px solid var(--rule-strong); }
  .st-time .when { font-family: var(--serif); font-size: 32px; line-height: 1.1; color: var(--gold-ink); }
  .st-time .when.small { font-size: 20px; }
  .st-time h3 { font-family: var(--serif); font-weight: 500; font-size: 22px; margin-bottom: 8px; }
  .st-end { display: grid; grid-template-columns: 140px minmax(0, 1fr) auto; gap: 40px; align-items: center; padding: 40px 0 72px; }
  .st-end .s-shot { aspect-ratio: 3 / 4; }
  .st-end .s-shot img { width: 86%; height: 92%; }
  .st-end h2 { font-family: var(--serif); font-weight: 500; font-size: 28px; margin: 8px 0; }
  @media (max-width: 989px) { .st-grid, .st-time { grid-template-columns: 1fr; gap: 32px; } .st-grid figure { max-width: 300px; } .st-time .intro { position: static; } .st-time ol li { grid-template-columns: 1fr; gap: 8px; } .st-end { grid-template-columns: 100px 1fr; gap: 20px; } .st-end .s-btn { grid-column: 1 / -1; } }
</style>
<div class="s">
  <section id="founder" class="st-open">
    <div class="s-wrap">
      <span class="s-kicker">The story · Behind IP6 Original</span>
      <h1 class="s-h1">The molecule a scientist spent his career on.</h1>
      <div class="st-grid">
        <figure><img src="{{ cdn }}/founder/shamsuddin.png" alt="Professor AbulKalam M. Shamsuddin in a suit and red bow tie" width="1024" height="1536" fetchpriority="high"><figcaption>Founder and formulator of IP6 Original</figcaption></figure>
        <div>
          <span class="s-kicker">Meet the founder</span>
          <h2>Professor AbulKalam M. Shamsuddin</h2>
          <p class="cred">MD, PhD</p>
          <p class="quoteish">A physician-scientist. A career spent on a single molecule.</p>
          <p class="s-body">Professor Shamsuddin pioneered research on inositol hexaphosphate at the University of Maryland School of Medicine before retiring in 2020.</p>
          <p class="s-body">He formulated IP6 Original to bring the product of that research directly to consumers.</p>
        </div>
      </div>
    </div>
  </section>
  <section id="research" class="s-band">
    <div class="s-wrap st-time">
      <div class="intro">
        <span class="s-kicker">The research</span>
        <h2 class="s-h2" style="margin:12px 0 16px">How the story unfolded.</h2>
        <p class="s-body">From his early publications to the original formula.</p>
        <a href="/pages/the-difference" class="s-link" style="margin-top:20px">About the formula {{ arrow }}</a>
      </div>
      <ol>
        <li><p class="when">1988</p><div><h3>A research focus takes shape.</h3><p class="s-body">At the University of Maryland School of Medicine, Professor Shamsuddin publishes his first paper on inositol hexaphosphate and applies for his first patent on June 30 of the same year.</p></div></li>
        <li><p class="when small">The years that followed</p><div><h3>A growing body of research.</h3><p class="s-body">Publication after publication. A growing body of peer-reviewed research. A research foundation to keep the work going. The molecule remains at the center of his work.</p></div></li>
        <li><p class="when">2020</p><div><h3>The work continues.</h3><p class="s-body">Professor Shamsuddin retires from the University of Maryland School of Medicine. The research continues.</p></div></li>
        <li><p class="when small">IP6 Original</p><div><h3>From research to formulation.</h3><p class="s-body">He formulates IP6 Original himself, bringing IP6 and Inositol together in a vegetable capsule. The pairing at the heart of his research becomes the original formula.</p></div></li>
      </ol>
    </div>
  </section>
  <section class="s-wrap st-end" style="border-top:1px solid var(--rule)">
    <div class="s-shot"><img src="{{ cdn }}/products/supplement-240.png" alt="IP6 Original Supplement, 240 capsules" width="870" height="1160" loading="lazy"></div>
    <div><span class="s-kicker">The story continues</span><h2>IP6 Original Supplement</h2><p class="s-body">IP6 and Inositol. The original formula, developed by Professor Shamsuddin. 240 capsules, 4 capsules per serving.</p></div>
    <a href="{{ all_products['ip-6-original'].url }}" class="s-btn">Pre Order Now</a>
  </section>
</div>
{% schema %}
{ "name": "IP6 Story", "tag": "section", "settings": [] }
{% endschema %}
