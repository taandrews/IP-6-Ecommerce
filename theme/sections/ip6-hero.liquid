{%- liquid
 assign p = section.settings.product
 assign img = section.settings.image
-%}
<style>
 #hero-{{ section.id }} { background: var(--paper); }
 #hero-{{ section.id }} .hero-grid {
 display: flex; flex-direction: row; gap: clamp(32px, 6vw, 80px); align-items: center;
 padding-top: clamp(48px, 8vw, 112px); padding-bottom: clamp(48px, 8vw, 112px);
 }
 #hero-{{ section.id }} .hero-grid > .hero-copy { flex: 1 1 auto; min-width: 0; }
 #hero-{{ section.id }} .hero-grid > .frame-wrap { flex: 0 0 clamp(300px, 34vw, 440px); }
 #hero-{{ section.id }} .eyebrow-row { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
 #hero-{{ section.id }} .prebook { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 20px; padding: 10px 18px; border: 1px solid var(--gold); border-radius: 100px; background: #fdfaf3; font-family: var(--sans); font-size: 14px; font-weight: 600; color: var(--gold-deep); }
 #hero-{{ section.id }} .prebook .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold-deep); }
 #hero-{{ section.id }} .eyebrow-row .line { height: 1px; width: 44px; background: var(--gold); }
 #hero-{{ section.id }} h1 { margin: 0 0 24px; max-width: 14ch; }
 #hero-{{ section.id }} .sub { max-width: 46ch; margin: 0 0 36px; color: var(--muted); }
 #hero-{{ section.id }} .actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
 #hero-{{ section.id }} .frame-wrap { position: relative; width: 100%; }
 /* Hero bottle sequence: drop-in with overshoot, wide float, molecule spheres orbiting in 3D, gold rings, pointer tilt and scroll parallax. Static under reduced motion. */
 #hero-{{ section.id }} .stage { position: relative; height: clamp(340px, 38vw, 560px); display: flex; align-items: center; justify-content: center; --rx: 0deg; --ry: 0deg; --tx: 0px; --ty: 0px; --py: 0px; --r: clamp(150px, 16vw, 240px); perspective: 1400px; }
 #hero-{{ section.id }} .glow { position: absolute; inset: -4% -16%; border-radius: 50%; background: radial-gradient(closest-side, rgba(197,162,83,.55), rgba(197,162,83,.3) 55%, rgba(197,162,83,0) 100%); filter: blur(22px); animation: ip6-glow 6s ease-in-out infinite; pointer-events: none; }
 #hero-{{ section.id }} .ring { position: absolute; left: 50%; top: 50%; width: 70%; aspect-ratio: 1; border: 1px solid rgba(197,162,83,.55); border-radius: 50%; transform: translate(-50%,-50%) scale(.5); opacity: 0; animation: ip6-ring 7s cubic-bezier(.2,.6,.3,1) infinite; pointer-events: none; }
 #hero-{{ section.id }} .ring.r2 { animation-delay: 2.3s; }
 #hero-{{ section.id }} .ring.r3 { animation-delay: 4.6s; }
 #hero-{{ section.id }} .tilt { position: relative; height: 100%; transform-style: preserve-3d; transform: translateY(var(--py)) rotateX(var(--rx)) rotateY(var(--ry)) translate(var(--tx), var(--ty)); transition: transform .9s cubic-bezier(.2,.7,.2,1); will-change: transform; }
 #hero-{{ section.id }} .float { height: 100%; transform-style: preserve-3d; animation: ip6-drop 1.3s cubic-bezier(.22,1.4,.36,1) both, ip6-float 5.5s ease-in-out 1.3s infinite; }
 #hero-{{ section.id }} .float img { height: 100%; width: auto; display: block; filter: drop-shadow(0 34px 34px rgba(0,44,92,.28)); }
 #hero-{{ section.id }} .shadow { position: absolute; bottom: 1%; left: 50%; width: 46%; height: 20px; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(closest-side, rgba(0,44,92,.34), rgba(0,44,92,0)); filter: blur(7px); animation: ip6-shadow-in 1.3s ease-out both, ip6-shadow 5.5s ease-in-out 1.3s infinite; pointer-events: none; }
 #hero-{{ section.id }} .orbit { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; opacity: 0; animation: ip6-spin var(--speed, 22s) linear infinite, ip6-orbit-in 1.2s ease-out .9s forwards; }
 #hero-{{ section.id }} .orbit.a { --speed: 24s; --tiltX: 72deg; }
 #hero-{{ section.id }} .orbit.b { --speed: 34s; --tiltX: 64deg; animation-direction: reverse, normal; }
 #hero-{{ section.id }} .node { position: absolute; left: 0; top: 0; width: var(--size, 22px); height: var(--size, 22px); margin: calc(var(--size, 22px) / -2); border-radius: 50%; transform: rotateX(var(--tiltX)) rotateZ(var(--a)) translateX(var(--r)) rotateZ(calc(-1 * var(--a))) rotateX(calc(-1 * var(--tiltX))); box-shadow: 0 6px 14px rgba(0,44,92,.25); }
 #hero-{{ section.id }} .node.gold { background: radial-gradient(circle at 32% 28%, #f4e3a4 0%, #d9bb64 35%, #b48d3a 70%, #7d5d1b 100%); }
 #hero-{{ section.id }} .node.navy { background: radial-gradient(circle at 32% 28%, #4d6f9d 0%, #1f3f6f 40%, #0b2345 75%, #04142b 100%); }
 @keyframes ip6-drop { 0% { opacity: 0; transform: translateY(140px) scale(.72) rotate(-10deg); } 60% { opacity: 1; } 100% { opacity: 1; transform: translateY(0) scale(1) rotate(0); } }
 @keyframes ip6-float { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-30px) rotate(2.5deg); } }
 @keyframes ip6-shadow-in { from { opacity: 0; transform: translateX(-50%) scaleX(.4); } to { opacity: .95; transform: translateX(-50%) scaleX(1); } }
 @keyframes ip6-shadow { 0%, 100% { transform: translateX(-50%) scaleX(1); opacity: .95; } 50% { transform: translateX(-50%) scaleX(.7); opacity: .45; } }
 @keyframes ip6-glow { 0%, 100% { opacity: .7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.1); } }
 @keyframes ip6-ring { 0% { opacity: 0; transform: translate(-50%,-50%) scale(.5); } 12% { opacity: .9; } 100% { opacity: 0; transform: translate(-50%,-50%) scale(1.75); } }
 @keyframes ip6-spin { from { transform: rotateZ(0); } to { transform: rotateZ(360deg); } }
 @keyframes ip6-orbit-in { from { opacity: 0; } to { opacity: 1; } }
 @media (prefers-reduced-motion: reduce) { #hero-{{ section.id }} .float, #hero-{{ section.id }} .shadow, #hero-{{ section.id }} .glow, #hero-{{ section.id }} .orbit { animation: none; opacity: 1; } #hero-{{ section.id }} .ring { display: none; } #hero-{{ section.id }} .tilt { transition: none; transform: none; } }
</style>

<section id="hero-{{ section.id }}" class="ip6 ip6-reveal">
 <div class="ip6-wrap hero-grid">
 <div class="hero-copy">
 <div class="eyebrow-row ip6-rise d1"><span class="line"></span><span class="ip6-eyebrow">{{ section.settings.eyebrow }}</span></div>
 <p class="prebook ip6-rise d1"><span class="dot" aria-hidden="true"></span>Pre-order open · 15% off · Starts shipping November 2026</p>
 <h1 class="ip6-display ip6-rise d2">{{ section.settings.heading }}</h1>
 <p class="sub ip6-body-lg ip6-rise d3">{{ section.settings.subheading }}</p>
 <div class="actions ip6-rise d4">
 {%- if p != blank -%}
 <a class="ip6-btn ip6-btn--primary" href="{{ p.url }}">Pre-Order · 15% Off</a>
 {%- else -%}
 <a class="ip6-btn ip6-btn--primary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
 {%- endif -%}
 <a class="ip6-textlink" href="{{ section.settings.link2 | default: '/pages/story' }}">{{ section.settings.link2_label }}</a>
 </div>
 </div>
 <div class="frame-wrap ip6-rise d3">
 <div class="stage" data-hero-stage>
 <div class="glow" aria-hidden="true"></div>
 <div class="ring" aria-hidden="true"></div><div class="ring r2" aria-hidden="true"></div><div class="ring r3" aria-hidden="true"></div>
 <div class="tilt">
 <div class="orbit a" aria-hidden="true">
 <span class="node gold" style="--a:0deg;--size:26px"></span><span class="node navy" style="--a:72deg;--size:16px"></span><span class="node gold" style="--a:144deg;--size:22px"></span><span class="node navy" style="--a:216deg;--size:14px"></span><span class="node gold" style="--a:288deg;--size:20px"></span>
 </div>
 <div class="float">
 {%- if img != blank -%}
 <img src="{{ img | image_url: width: 900 }}" alt="{{ p.title | default: 'IP6 Original' }}" width="532" height="900" loading="eager" fetchpriority="high">
 {%- else -%}
 <img src="{{ 'ip6-bottle-hero.png' | asset_url }}" alt="IP6 Original supplement bottle" width="532" height="900" loading="eager" fetchpriority="high">
 {%- endif -%}
 </div>
 <div class="orbit b" aria-hidden="true">
 <span class="node navy" style="--a:30deg;--size:18px"></span><span class="node gold" style="--a:120deg;--size:24px"></span><span class="node gold" style="--a:210deg;--size:14px"></span><span class="node navy" style="--a:300deg;--size:20px"></span>
 </div>
 </div>
 <div class="shadow" aria-hidden="true"></div>
 </div>
 <p class="cap ip6-caption">120 capsules · 60 servings</p>
 </div>
 </div>
</section>
<script>
(function () {
 var stage = document.querySelector('#hero-{{ section.id }} [data-hero-stage]');
 if (!stage || !window.matchMedia) return;
 if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
 var area = stage.closest('section') || stage, raf = 0;
 var onScroll = function () { stage.style.setProperty('--py', (Math.min(window.scrollY, 900) * 0.22).toFixed(1) + 'px'); };
 window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
 if (!window.matchMedia('(pointer: fine)').matches) return;
 area.addEventListener('pointermove', function (e) {
  var r = area.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
  cancelAnimationFrame(raf);
  raf = requestAnimationFrame(function () {
   stage.style.setProperty('--rx', (-y * 14).toFixed(2) + 'deg');
   stage.style.setProperty('--ry', (x * 22).toFixed(2) + 'deg');
   stage.style.setProperty('--tx', (x * 36).toFixed(1) + 'px');
   stage.style.setProperty('--ty', (y * 24).toFixed(1) + 'px');
  });
 });
 area.addEventListener('pointerleave', function () {
  cancelAnimationFrame(raf);
  ['--rx', '--ry', '--tx', '--ty'].forEach(function (v) { stage.style.removeProperty(v); });
 });
})();
</script>

{% schema %}
{
 "name": "IP6 Hero",
 "tag": "section",
 "settings": [
 { "type": "product", "id": "product", "label": "Featured product" },
 { "type": "image_picker", "id": "image", "label": "Product image (4:5)" },
 { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the lab of Professor AbulKalam M. Shamsuddin, MD, PhD" },
 { "type": "text", "id": "heading", "label": "Heading", "default": "There is only one IP6 Original." },
 { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The first IP6 supplement standardized to the research-grade purity Prof. Shamsuddin's work defined, 804 mg of inositol hexaphosphate with Inositol, in every serving." },
 { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop IP6 Original" },
 { "type": "url", "id": "button_link", "label": "Button link" },
 { "type": "text", "id": "link2_label", "label": "Secondary link label", "default": "Read the story" },
 { "type": "url", "id": "link2", "label": "Secondary link" }
 ],
 "presets": [{ "name": "IP6 Hero" }]
}
{% endschema %}
